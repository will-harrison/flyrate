# Flyrate — environment variables
#
# Copy this file to .env.local and fill in the real values from your Supabase project.
# .env.local is gitignored and must NEVER be committed.
#
# SECURITY: The anon (publishable) key is the ONLY Supabase key permitted in a
# NEXT_PUBLIC_ variable — it is safe to ship to the browser and is governed by RLS.
# NEVER put the service-role key here or in any NEXT_PUBLIC_ variable: it bypasses
# RLS entirely and would compromise all data if exposed to the client.

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Dashboard -> Account -> Access Tokens
# Used ONLY for non-interactive `supabase db push` from your local machine.
# Never exposed to the client; never prefixed with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
